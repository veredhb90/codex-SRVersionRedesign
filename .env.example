# Server and database
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/swingrush
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5000
# Optional for safe local UI/API testing against an existing database
# DISABLE_SCANNER_AUTOSTART=true
# DISABLE_BACKGROUND_JOBS=true

# Market intelligence
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_CHAT_REASONING_EFFORT=medium
OPENAI_PRO_MODEL=gpt-5.6-sol
OPENAI_PRO_REASONING_EFFORT=high
# Backward-compatible legacy overrides: OPENAI_MODEL, OPENAI_REASONING_EFFORT,
# and OPENAI_NEWS_REASONING_EFFORT are still accepted when role-specific values
# are not set.
# Optional Pro Engine AI-news cache TTL in milliseconds (default 1800000 / 30 minutes)
# OPENAI_NEWS_CACHE_MS=1800000
# Optional API timeout in milliseconds (default 180000)
# OPENAI_API_TIMEOUT_MS=180000
FINNHUB_API_KEY=your_finnhub_api_key

# Transactional email
RESEND_API_KEY=your_resend_api_key
